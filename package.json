{
  "name": "jot-canvas-lab",
  "version": "0.0.1-beta.9",
  "description": "Experimental interactive source surfaces for Obsidian Canvas.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "canvas",
    "pdf",
    "annotation",
    "apple-pencil"
  ],
  "author": "Chadillac12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chadillac12/jot-canvas-lab.git"
  },
  "bugs": {
    "url": "https://github.com/Chadillac12/jot-canvas-lab/issues"
  },
  "homepage": "https://github.com/Chadillac12/jot-canvas-lab",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  }
}
